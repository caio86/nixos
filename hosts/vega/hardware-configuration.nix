# Generated by nixos-generate-config, plus extra disks. The system disk's
# filesystems are defined in disko.nix.
{
  config,
  lib,
  pkgs,
  modulesPath,
  ...
}:

{
  imports = [
    (modulesPath + "/installer/scan/not-detected.nix")
  ];

  boot.initrd.availableKernelModules = [
    "xhci_pci"
    "ahci"
    "nvme"
    "usbhid"
  ];
  boot.initrd.kernelModules = [ ];
  boot.kernelModules = [ "kvm-amd" ];
  boot.extraModulePackages = [ ];

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.amd.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;

  boot.supportedFilesystems = [
    "ntfs"
    "nfs"
  ];

  # Second NVMe (NTFS, shared with Windows)
  fileSystems."/mnt/games" = {
    device = "/dev/disk/by-uuid/62E68DDF1D351933";
    fsType = "ntfs";
    options = [
      "rw"
      "uid=${toString config.users.users.${config.C410l.user.name}.uid}"
      "gid=100"
      "umask=000"
      "user"
      "exec"
      "nofail"
      "noatime"
    ];
  };
}
